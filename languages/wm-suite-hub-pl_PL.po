#. Plugin Name of the plugin
#: wm-suite-hub.php
msgid "WM Suite Hub (Enterprise Cockpit)"
msgstr "WM Suite Hub (Kokpit Enterprise)"

#. Plugin URI of the plugin
#: wm-suite-hub.php
msgid "https://arnoldwender.com/wordpress-plugins/wm-suite-hub/"
msgstr "https://arnoldwender.com/wordpress-plugins/wm-suite-hub/"

#. Description of the plugin
#: wm-suite-hub.php
msgid ""
"Registry and health overview of the WM Suite plugins, a CycloneDX 1.6 "
"software bill of materials and an audit table whose entries are chained with "
"HMAC-SHA256."
msgstr ""
"Rejestr i przegląd stanu wtyczek WM Suite, wykaz komponentów oprogramowania "
"CycloneDX 1.6 oraz tabela audytu, której wpisy są powiązane łańcuchowo za "
"pomocą HMAC-SHA256."

