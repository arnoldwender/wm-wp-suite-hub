{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wm/event-booking-cta",
	"version": "1.2.6",
	"title": "WM Event Booking CTA Button",
	"category": "wm-suite",
	"icon": "tickets-alt",
	"description": "Button to the booking page you enter, with an optional note under it. Visitors see nothing until a URL is entered.",
	"keywords": ["booking", "cta", "button", "tickets"],
	"textdomain": "wm-suite-hub",
	"editorScript": "wm-suite-hub-blocks-editor",
	"attributes": {
		"buttonText": {
			"type": "string",
			"default": ""
		},
		"bookingUrl": {
			"type": "string",
			"default": ""
		},
		"taxNote": {
			"type": "string",
			"default": ""
		}
	}
}
