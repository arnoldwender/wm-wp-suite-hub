{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wm/a11y-contrast-switch",
	"version": "1.2.6",
	"title": "WM Accessibility Toolbar",
	"category": "wm-suite",
	"icon": "universal-access-alt",
	"description": "Buttons for high contrast in the WM Suite blocks, a reading font installed on the visitor's device, and larger text. The choice stays in the browser.",
	"keywords": ["a11y", "bfsg", "barrierefreiheit", "contrast", "dyslexia"],
	"textdomain": "wm-suite-hub",
	"editorScript": "wm-suite-hub-blocks-editor",
	"attributes": {
		"showHighContrast": {
			"type": "boolean",
			"default": true
		},
		"showDyslexicFont": {
			"type": "boolean",
			"default": true
		},
		"showTextScaler": {
			"type": "boolean",
			"default": true
		}
	}
}
